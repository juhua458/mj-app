<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 截屏权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 悬浮窗权限 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Android 14+ 悬浮窗前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="麻将截屏助手"
        android:supportsRtl="true"
        android:theme="@style/Theme.MjScreenshot"
        android:usesCleartextTraffic="true">

        <property
            android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
            android:value="Floating overlay window for mahjong game assistance" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="麻将截屏助手"
            android:theme="@style/Theme.MjScreenshot">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".HelperActivity"
            android:label="捉鸡麻将提示器"
            android:theme="@style/Theme.MjScreenshot"
            android:exported="false" />

        <!-- 截屏前台服务 -->
        <service
            android:name=".ScreenCaptureService"
            android:foregroundServiceType="mediaProjection"
            android:exported="false" />

        <!-- HTTP服务器服务 -->
        <service
            android:name=".HttpServerService"
            android:exported="false" />

        <!-- 悬浮窗服务 -->
        <service
            android:name=".FloatingService"
            android:foregroundServiceType="specialUse"
            android:exported="false" />

    </application>
</manifest>
